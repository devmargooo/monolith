{
  "name": "@monolith/payservice-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@monolith/payservice"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/payservice-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@monolith/payservice:build",
          "@monolith/payservice:serve"
        ]
      }
    }
  }
}
